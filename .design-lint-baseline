# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 29
padding-literal 118
spacing-literal 137
radius-literal 16
hex-color 8
raw-color 11
raw-control 14
file-length 3
try-bang 0
force-cast 0
force-unwrap 2
print 0
opacity-literal 247
frame-literal 60
chamfer-literal 0
motion-literal 25
