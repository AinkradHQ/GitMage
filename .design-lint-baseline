# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 24
padding-literal 81
spacing-literal 100
radius-literal 7
hex-color 7
raw-color 11
raw-control 5
file-length 0
try-bang 0
force-cast 0
force-unwrap 1
print 0
opacity-literal 151
frame-literal 45
chamfer-literal 0
motion-literal 12
