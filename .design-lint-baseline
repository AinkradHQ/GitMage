# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 17
padding-literal 45
spacing-literal 72
radius-literal 2
hex-color 0
raw-color 0
raw-control 0
file-length 0
try-bang 0
force-cast 0
force-unwrap 1
print 0
opacity-literal 79
frame-literal 27
chamfer-literal 0
motion-literal 3
