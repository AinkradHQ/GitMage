# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 27
padding-literal 88
spacing-literal 107
radius-literal 10
hex-color 7
raw-color 11
raw-control 8
file-length 0
try-bang 0
force-cast 0
force-unwrap 1
print 0
opacity-literal 169
frame-literal 48
chamfer-literal 0
motion-literal 12
