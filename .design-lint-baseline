# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 27
padding-literal 84
spacing-literal 104
radius-literal 7
hex-color 7
raw-color 11
raw-control 7
file-length 0
try-bang 0
force-cast 0
force-unwrap 1
print 0
opacity-literal 161
frame-literal 46
chamfer-literal 0
motion-literal 12
